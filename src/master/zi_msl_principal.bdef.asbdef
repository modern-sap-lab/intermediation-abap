managed implementation in class zbp_i_msl_principal unique;
strict ( 2 );

define behavior for ZI_MSL_PRINCIPAL alias Principal
persistent table zmsl_principal
lock master
authorization master ( none )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly )
    PrincipalUUID;

  field ( readonly )
    CreatedBy,
    CreatedAt,
    LocalLastChangedBy,
    LocalLastChangedAt,
    LastChangedAt;

  mapping for zmsl_principal
  {
    PrincipalUUID           = principal_uuid;
    ExternalCode            = external_code;
    Name                    = name;
    DefaultCommissionPct    = default_commission_pct;
    Status                  = status;
    SapBusinessPartner      = sap_business_partner;
    CreatedBy               = created_by;
    CreatedAt               = created_at;
    LocalLastChangedBy      = local_last_changed_by;
    LocalLastChangedAt      = local_last_changed_at;
    LastChangedAt           = last_changed_at;
  }
}